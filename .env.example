# Kong
KONG_DB_PASSWORD=changeme-kong-db

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-keycloak-admin
KEYCLOAK_REALM=saas-platform
KEYCLOAK_LAB_USER_PASSWORD=TestPass123!
KEYCLOAK_HOST_PORT=18080
KC_DB_PASSWORD=changeme-keycloak-db

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_MULTIPLE_DATABASES=keycloak,kong,userdb,resourcedb,admindb,paymentdb

# Redis
REDIS_PASSWORD=changeme-redis

# Vault dev mode
VAULT_DEV_TOKEN=root-token-for-lab-only

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana

# Service DB passwords
USER_SVC_DB_PASSWORD=changeme-user-db
RESOURCE_SVC_DB_PASSWORD=changeme-resource-db
ADMIN_SVC_DB_PASSWORD=changeme-admin-db
PAYMENT_SVC_DB_PASSWORD=changeme-payment-db

# Service settings
SERVICE_NAME=resource-service
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:changeme-postgres@postgres:5432/resourcedb
REQUEST_ID_HEADER=X-Request-ID
TENANT_ID_HEADER=X-Tenant-ID
USER_ID_HEADER=X-User-ID
JWKS_CACHE_TTL_SECONDS=300

# Stripe sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OIDC/OAuth2
KEYCLOAK_URL=http://keycloak:8080
JWT_AUDIENCE=saas-api
JWT_ISSUER=http://localhost:18080/realms/saas-platform
OIDC_ISSUER=http://keycloak:8080/realms/saas-platform
OIDC_AUDIENCE=saas-api

# Vault
VAULT_ADDR=http://vault:8200
