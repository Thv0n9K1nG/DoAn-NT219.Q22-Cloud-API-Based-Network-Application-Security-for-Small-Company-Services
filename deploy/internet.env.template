# Copy values from this template into .env on the VPS, then replace all changeme values.
# Required for Caddy public HTTPS.
PUBLIC_DOMAIN=api.example.com

# Let Caddy expose 80/443 publicly. Keep Kong host-published ports on localhost only.
KONG_PROXY_HTTP_PORT=127.0.0.1:18000
KONG_PROXY_HTTPS_PORT=127.0.0.1:18443

# Keep admin/internal panels on localhost. Access with SSH tunnels when needed.
KEYCLOAK_HOST_PORT=18080
OPA_HOST_PORT=8181
VAULT_HOST_PORT=8200
GRAFANA_HOST_PORT=3000
LOKI_HOST_PORT=3100

# Replace these before deployment.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-replace-me
KEYCLOAK_REALM=saas-platform
KEYCLOAK_LAB_USER_PASSWORD=changeme-replace-me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-replace-me
POSTGRES_MULTIPLE_DATABASES=keycloak,kong,userdb,resourcedb,admindb,paymentdb
REDIS_PASSWORD=changeme-replace-me
VAULT_DEV_TOKEN=changeme-replace-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-replace-me

# Optional real Stripe sandbox keys. Lab fallback works without these but is less realistic.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Service and OIDC settings.
LOG_LEVEL=INFO
JWT_AUDIENCE=saas-api
JWT_ISSUER=http://localhost:18080/realms/saas-platform
KEYCLOAK_URL=http://keycloak:8080
VAULT_ADDR=http://vault:8200
