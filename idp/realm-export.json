{
  "realm": "saas-platform",
  "enabled": true,
  "displayName": "Small Company SaaS Platform",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 86400,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "tenant_admin", "description": "Tenant administrator" },
      { "name": "tenant_user", "description": "Tenant user" },
      { "name": "platform_admin", "description": "Platform administrator" },
      { "name": "read:users" },
      { "name": "write:users" },
      { "name": "delete:users" },
      { "name": "read:resources" },
      { "name": "write:resources" },
      { "name": "delete:resources" },
      { "name": "read:billing" },
      { "name": "write:billing" },
      { "name": "read:admin" },
      { "name": "write:admin" }
    ]
  },
  "clients": [
    {
      "clientId": "saas-spa",
      "name": "SaaS SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3001/callback", "http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_name",
            "claim.name": "org_name",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-saas-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "saas-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "saas-mobile",
      "name": "SaaS Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["com.example.saas:/oauth2redirect", "http://localhost:3002/callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_name",
            "claim.name": "org_name",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-saas-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "saas-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "saas-m2m",
      "name": "SaaS Machine-to-Machine",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "changeme-saas-m2m-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience-saas-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "saas-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kong-introspect",
      "name": "Kong Introspection",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "changeme-kong-introspect-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "alpha-admin@example.com",
      "email": "alpha-admin@example.com",
      "firstName": "Alpha",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"],
        "org_name": ["tenant-alpha"]
      },
      "credentials": [{ "type": "password", "value": "TestPass123!", "temporary": false }],
      "realmRoles": ["tenant_admin", "read:users", "write:users", "read:resources", "write:resources", "read:billing"]
    },
    {
      "username": "alpha-user@example.com",
      "email": "alpha-user@example.com",
      "firstName": "Alpha",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["11111111-1111-1111-1111-111111111111"],
        "org_name": ["tenant-alpha"]
      },
      "credentials": [{ "type": "password", "value": "TestPass123!", "temporary": false }],
      "realmRoles": ["tenant_user", "read:resources", "write:resources"]
    },
    {
      "username": "beta-admin@example.com",
      "email": "beta-admin@example.com",
      "firstName": "Beta",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["22222222-2222-2222-2222-222222222222"],
        "org_name": ["tenant-beta"]
      },
      "credentials": [{ "type": "password", "value": "TestPass123!", "temporary": false }],
      "realmRoles": ["tenant_admin", "read:users", "write:users", "read:resources", "write:resources", "read:billing"]
    },
    {
      "username": "beta-user@example.com",
      "email": "beta-user@example.com",
      "firstName": "Beta",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": ["22222222-2222-2222-2222-222222222222"],
        "org_name": ["tenant-beta"]
      },
      "credentials": [{ "type": "password", "value": "TestPass123!", "temporary": false }],
      "realmRoles": ["tenant_user", "read:resources", "write:resources"]
    },
    {
      "username": "platform-admin@example.com",
      "email": "platform-admin@example.com",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [""],
        "org_name": ["platform"]
      },
      "credentials": [{ "type": "password", "value": "TestPass123!", "temporary": false }],
      "realmRoles": ["platform_admin", "read:admin", "write:admin"]
    }
  ]
}
