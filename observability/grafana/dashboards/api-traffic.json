{
  "uid": "nt219-api-traffic",
  "title": "NT219 API Traffic Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": ["nt219", "api", "loki"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values(service)",
        "includeAll": true,
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests by service",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (service) (count_over_time({event=\"api.request\", service=~\"$service\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "4xx responses by service",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (service) (count_over_time({event=\"api.request\", service=~\"$service\", status_code=~\"4..\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx responses by service",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (service) (count_over_time({event=\"api.request\", service=~\"$service\", status_code=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "P95 latency by service",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "quantile_over_time(0.95, {event=\"api.request\", service=~\"$service\"} | json | unwrap latency_ms [5m]) by (service)"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent API requests",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{event=\"api.request\", service=~\"$service\"} | json | line_format \"{{.timestamp}} {{.service}} {{.method}} {{.path}} {{.status_code}} {{.latency_ms}}ms request_id={{.request_id}}\""
        }
      ]
    }
  ]
}
